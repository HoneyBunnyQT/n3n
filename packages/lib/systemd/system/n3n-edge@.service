[Unit]
Description=n3n edge process, on %I
Documentation=man:n3n-edge(8)
After=network-online.target nfw.target
Wants=network-online.target

[Service]
# n3n tells systemd when it is up, how it is doing (systemctl status) and
# that its main loop still runs; see docs/configure/Systemd.md
Type=notify
NotifyAccess=main
WatchdogSec=60
ExecStartPre=
ExecStart=/usr/sbin/n3n-edge start %i
Restart=on-abnormal
RestartSec=5

[Install]
WantedBy=multi-user.target
Alias=
