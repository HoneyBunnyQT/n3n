<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- the app, and the network -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/network"
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- the state, and the button -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- the state is in the button: see ConnectButton -->
            <dev.n3n.android.ConnectButton
                android:id="@+id/connect"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:background="@color/line" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shrinkColumns="1"
                android:stretchColumns="1">

                <TableRow android:paddingTop="8dp">
                    <TextView style="@style/Label" android:text="@string/address" />
                    <TextView
                        android:id="@+id/address"
                        style="@style/Value"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </TableRow>

                <TableRow android:paddingTop="8dp">
                    <TextView style="@style/Label" android:text="@string/supernode" />
                    <TextView
                        android:id="@+id/supernode"
                        style="@style/Value"
                        android:fontFamily="monospace"
                        android:gravity="end" />
                </TableRow>

                <TableRow android:paddingTop="8dp">
                    <TextView style="@style/Label" android:text="@string/peers" />
                    <TextView
                        android:id="@+id/peers"
                        style="@style/Value"
                        android:gravity="end" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- what else there is, as keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <dev.n3n.android.Key
                android:id="@+id/scan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_scan"
                android:text="@string/key_scan" />

            <dev.n3n.android.Key
                android:id="@+id/edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_edit"
                android:text="@string/key_edit" />

            <dev.n3n.android.Key
                android:id="@+id/share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_share"
                android:text="@string/share" />

            <dev.n3n.android.Key
                android:id="@+id/log"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_log"
                android:text="@string/log" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- routing everything through a peer, an exit node -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <Switch
                android:id="@+id/route_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_all"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/route_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/route_gateway" />

                <EditText
                    android:id="@+id/gateway"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field"
                    android:digits="0123456789."
                    android:fontFamily="monospace"
                    android:hint="10.1.2.1"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_dim" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/route_dns" />

                <EditText
                    android:id="@+id/dns"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field"
                    android:digits="0123456789."
                    android:fontFamily="monospace"
                    android:hint="1.1.1.1"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_dim" />

                <TextView
                    style="@style/Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/route_note" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
